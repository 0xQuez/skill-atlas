# Build outputs, caches, and local environments
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store
.idea/
.vscode/

# Pipeline data and downloads (too large for git; published separately)
/out/
/data/
/tmp/
/.tmp/
/logs/
/sample/
/hf/

# Hugging Face staging: keep cards and scripts, not the data or built site
hf_publish/dataset/*
!hf_publish/dataset/README.md
hf_publish/space_dashboard/*
!hf_publish/space_dashboard/README.md
!hf_publish/space_dashboard/.gitattributes

# Dashboard
dashboard/node_modules/
dashboard/dist/
dashboard/dist_*/
dashboard/src/.observablehq/cache/
dashboard/src/data/*.parquet
dashboard/screenshots/*
!dashboard/screenshots/overview.png
!dashboard/screenshots/search-whitehat.png
!dashboard/screenshots/eval.png

# Large binary artifacts (backstop)
*.duckdb
*.duckdb.wal
*.npz
*.npy
*.parquet

# Baked API Parquet (staged for the Space only) and a copy of server/app.py
hf_publish/space_api/data/
hf_publish/space_api/__pycache__/
hf_publish/space_api/atlas_server.py
